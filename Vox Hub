    local lbl = Instance.new("TextLabel"); lbl.Size=UDim2.new(1,-22,1,0); lbl.Position=UDim2.fromOffset(16,0); lbl.BackgroundTransparency=1; lbl.Font=Enum.Font.GothamMedium; lbl.TextSize=13; lbl.TextColor3=C.textDim; lbl.TextXAlignment=Enum.TextXAlignment.Left; lbl.Text=nome; lbl.ZIndex=5; lbl.Parent=btn
    local pg = Instance.new("ScrollingFrame"); pg.Size=UDim2.fromScale(1,1); pg.BackgroundTransparency=1; pg.BorderSizePixel=0; pg.ScrollBarThickness=3; pg.ScrollBarImageColor3=C.stroke; pg.CanvasSize=UDim2.new(0,0,0,0); pg.AutomaticCanvasSize=Enum.AutomaticSize.Y; pg.Visible=false; pg.ZIndex=4; pg.Parent=content
    local p = Instance.new("UIPadding"); p.PaddingTop=UDim.new(0,4); p.PaddingLeft=UDim.new(0,4); p.PaddingRight=UDim.new(0,12); p.PaddingBottom=UDim.new(0,12); p.Parent=pg
    local l = Instance.new("UIListLayout"); l.Padding=UDim.new(0,8); l.SortOrder=Enum.SortOrder.LayoutOrder; l.Parent=pg
    abas[nome]={btn=btn,barra=barra,lbl=lbl}; paginas[nome]=pg
    btn.MouseEnter:Connect(function() if abaAtual~=nome then tween(btn,{BackgroundTransparency=0},0.15); tween(lbl,{TextColor3=C.text},0.15) end end)
    btn.MouseLeave:Connect(function() if abaAtual~=nome then tween(btn,{BackgroundTransparency=1},0.15); tween(lbl,{TextColor3=C.textDim},0.15) end end)
    btn.MouseButton1Click:Connect(function()
        if abaAtual==nome then return end
        if abaAtual then local old=abas[abaAtual]; tween(old.btn,{BackgroundTransparency=1},0.15); tween(old.lbl,{TextColor3=C.textDim},0.15); tween(old.barra,{BackgroundTransparency=1},0.15); paginas[abaAtual].Visible=false end
        abaAtual=nome
        tween(btn,{BackgroundTransparency=0},0.15); tween(lbl,{TextColor3=C.text},0.15); tween(barra,{BackgroundTransparency=0},0.15)
        local pg2 = paginas[nome]; pg2.Visible=true; pg2.Position=UDim2.fromOffset(0,8); tween(pg2,{Position=UDim2.fromOffset(0,0)},0.25)
    end)
    registrar(function(cores)
        btn.BackgroundColor3=cores.card; barra.BackgroundColor3=cores.accent
        if abaAtual==nome then lbl.TextColor3=cores.text else lbl.TextColor3=cores.textDim end
        pg.ScrollBarImageColor3=cores.stroke
    end)
    return pg
end

