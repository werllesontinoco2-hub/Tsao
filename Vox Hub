-- Helper: criar toggle
local function makeToggle(parent, order, label)
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(1, 0, 0, 36)
    frame.BackgroundColor3 = toggleOff
    frame.BorderSizePixel = 0
    frame.LayoutOrder = order
    frame.Parent = parent

    local fc = Instance.new("UICorner")
    fc.CornerRadius = UDim.new(0, 8)
    fc.Parent = frame

    local label2 = Instance.new("TextLabel")
    label2.Size = UDim2.new(0, 200, 1, 0)
    label2.Position = UDim2.new(0, 12, 0, 0)
    label2.BackgroundTransparency = 1
    label2.Text = label
    label2.TextColor3 = textWhite
    label2.TextSize = 13
    label2.Font = Enum.Font.Gotham
    label2.TextXAlignment = Enum.TextXAlignment.Left
    label2.Parent = frame

    local toggle = Instance.new("TextButton")
    toggle.Size = UDim2.new(0, 50, 0, 24)
    toggle.Position = UDim2.new(1, -62, 0.5, -12)
    toggle.BackgroundColor3 = accent
    toggle.Text = "ON"
    toggle.TextColor3 = textWhite
    toggle.TextSize = 11
    toggle.Font = Enum.Font.GothamBold
    toggle.BorderSizePixel = 0
    toggle.Parent = frame

    local tc = Instance.new("UICorner")
    tc.CornerRadius = UDim.new(0, 6)
    tc.Parent = toggle

    local isOn = true
    toggle.MouseButton1Click:Connect(function()
        isOn = not isOn
        toggle.Text = isOn and "ON" or "OFF"
        toggle.BackgroundColor3 = isOn and accent or Color3.fromRGB(40, 35, 55)
    end)

    return frame
end

-- Helper: criar botão simples
local function makeButton(parent, order, label)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 0, 36)
    btn.BackgroundColor3 = toggleOff
    btn.Text = label
    btn.TextColor3 = textWhite
    btn.TextSize = 13
    btn.Font = Enum.Font.Gotham
    btn.BorderSizePixel = 0
    btn.LayoutOrder = order
    btn.Parent = parent

    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, 8)
    c.Parent = btn

    btn.MouseButton1Click:Connect(function()
        btn.BackgroundColor3 = accentDim
        task.delay(0.15, function()
            btn.BackgroundColor3 = toggleOff
        end)
    end)

    return btn
end

