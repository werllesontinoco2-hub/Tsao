local function fromHex(h) h=h:gsub("#",""); if #h~=6 then return nil end; local r=tonumber(h:sub(1,2),16); local g=tonumber(h:sub(3,4),16); local b=tonumber(h:sub(5,6),16); if not(r and g and b) then return nil end; return Color3.fromRGB(r,g,b) end

