local abas, paginas, abaAtual = {}, {}, nil
local function criarPagina(nome)
    local btn = Instance.new("TextButton"); btn.Size=UDim2.new(1,0,0,34); btn.BackgroundColor3=C.card; btn.BackgroundTransparency=1; btn.Text=""; btn.AutoButtonColor=false; btn.ZIndex=4; btn.Parent=sidebar; corner(btn,8)
