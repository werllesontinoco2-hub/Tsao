local function createNavItem(text, isActive)
    local btn = Instance.new("TextButton")
    btn.Parent = navFrame
    btn.Size = UDim2.new(1, 0, 0, 36)
    btn.BackgroundColor3 = isActive and Colors.Card or Color3.fromRGB(26, 28, 35)
    btn.BackgroundTransparency = isActive and 0 or 1
    btn.BorderSizePixel = 0
    btn.Text = ""
    btn.ZIndex = 8
    
    local itemCorner = Instance.new("UICorner")
    itemCorner.CornerRadius = UDim.new(0, 6)
    itemCorner.Parent = btn

    local label = Instance.new("TextLabel")
    label.Parent = btn
    label.Size = UDim2.new(1, -20, 1, 0)
    label.Position = UDim2.new(0, 15, 0, 0)
    label.BackgroundTransparency = 1
    label.Text = text
    label.TextColor3 = isActive and Colors.TextWhite or Colors.TextGray
    label.TextSize = 13
    label.Font = Enum.Font.GothamMedium
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.ZIndex = 9
    
    if isActive then
        local indicator = Instance.new("Frame")
        indicator.Parent = btn
        indicator.Size = UDim2.new(0, 3, 1, 0)
        indicator.Position = UDim2.new(0, 0, 0, 0)
        indicator.BackgroundColor3 = Colors.TextWhite
        indicator.BorderSizePixel = 0
        indicator.ZIndex = 9
        
        local indCorner = Instance.new("UICorner")
        indCorner.CornerRadius = UDim.new(0, 2)
        indCorner.Parent = indicator
    end
end

