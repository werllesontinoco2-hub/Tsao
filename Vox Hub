function CreateTab(name)
    local index = #TabObjects + 1
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 0, 32)
    btn.BackgroundColor3 = Color3.fromRGB(32, 32, 40)
    btn.BackgroundTransparency = 1
    btn.BorderSizePixel = 0
    btn.Text = ""
    btn.AutoButtonColor = false
    btn.LayoutOrder = index
    btn.Parent = TabList

    local bCorner = Instance.new("UICorner")
    bCorner.CornerRadius = UDim.new(0, 6)
    bCorner.Parent = btn

    local accent = Instance.new("Frame")
    accent.Size = UDim2.new(0, 3, 0.6, 0)
    accent.AnchorPoint = Vector2.new(0, 0.5)
    accent.Position = UDim2.new(0, 0, 0.5, 0)
    accent.BackgroundColor3 = Color3.fromRGB(255, 90, 90)
    accent.BorderSizePixel = 0
    accent.Visible = false
    accent.Parent = btn

    local aCorner = Instance.new("UICorner")
    aCorner.CornerRadius = UDim.new(0, 2)
    aCorner.Parent = accent

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, -18, 1, 0)
    lbl.Position = UDim2.new(0, 12, 0, 0)
    lbl.BackgroundTransparency = 1
    lbl.Font = Enum.Font.GothamMedium
    lbl.TextSize = 13
    lbl.TextColor3 = Color3.fromRGB(150, 150, 160)
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Text = name
    lbl.Parent = btn

    local content = Instance.new("ScrollingFrame")
    content.Size = UDim2.new(1, 0, 1, 0)
    content.BackgroundTransparency = 1
    content.BorderSizePixel = 0
    content.ScrollBarThickness = 4
    content.ScrollBarImageColor3 = Color3.fromRGB(55, 55, 65)
    content.CanvasSize = UDim2.new(0, 0, 0, 0)
    content.AutomaticCanvasSize = Enum.AutomaticSize.Y
    content.Visible = false
    content.Parent = ContentArea

    local cLayout = Instance.new("UIListLayout")
    cLayout.Padding = UDim.new(0, 8)
    cLayout.SortOrder = Enum.SortOrder.LayoutOrder
    cLayout.Parent = content

    local cPad = Instance.new("UIPadding")
    cPad.PaddingLeft = UDim.new(0, 12)
    cPad.PaddingRight = UDim.new(0, 12)
    cPad.PaddingTop = UDim.new(0, 12)
    cPad.PaddingBottom = UDim.new(0, 12)
    cPad.Parent = content

    local tabObj = {
        Index = index,
        Content = content,
        Button = btn,
        Accent = accent,
        Label = lbl
    }

    local function Select()
        for i, t in ipairs(TabObjects) do
            local sel = (i == index)
            t.Content.Visible = sel
            t.Accent.Visible = sel
            t.Button.BackgroundTransparency = sel and 0.85 or 1
            t.Button.BackgroundColor3 = Color3.fromRGB(32, 32, 40)
            t.Label.TextColor3 = sel and Color3.fromRGB(235, 235, 240) or Color3.fromRGB(150, 150, 160)
        end
    end

    btn.MouseButton1Click:Connect(Select)
    btn.MouseEnter:Connect(function()
        if not content.Visible then lbl.TextColor3 = Color3.fromRGB(235, 235, 240) end
    end)
    btn.MouseLeave:Connect(function()
        if not content.Visible then lbl.TextColor3 = Color3.fromRGB(150, 150, 160) end
    end)

    table.insert(TabObjects, tabObj)

    if index == 1 then Select() end

    return tabObj
end

